{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/nyabungo2.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/nyabungo2.html",
      "permanent": false
    },
    {
      "source": "/nyabungo1.html",
      "destination": "/nyabungo2.html",
      "permanent": false
    },
    {
      "source": "/comparatif.html",
      "destination": "/nyabungo2.html",
      "permanent": false
    },
    {
      "source": "/deploy/:rest*",
      "destination": "/nyabungo2.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
